# Copy to .env and fill in. .env is git-ignored.
# For a first `make up` you only need OPENAI_API_KEY; the rest have working defaults.

# ---------------------------------------------------------------------------
# Postgres (shared container; one database per service)
# ---------------------------------------------------------------------------
POSTGRES_USER=owl
POSTGRES_PASSWORD=owl
POSTGRES_DB=owl
# databases owl_api and owl_admin are created on first boot by
# docker/postgres/initdb/10-databases.sql

# ---------------------------------------------------------------------------
# owl-api (FastAPI)
# ---------------------------------------------------------------------------
OWL_API_DATABASE_URL=postgresql+psycopg://owl:owl@postgres:5432/owl_api
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LangSmith tracing — optional for now; leave TRACING=false until you have a key
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=owl-dev

# Browser origins allowed to call owl-api directly (status probe now; SSE later)
OWL_WEB_ORIGINS=http://localhost:5173

# Trust boundary with owl-admin (Phase 1 replaces the shared secret with JWT+JWKS)
OWL_INTERNAL_TOKEN=dev-internal-token-change-me
OWL_ADMIN_JWKS_URL=http://owl-admin:3000/.well-known/jwks.json
OWL_JWT_AUDIENCE=owl-api
OWL_JWT_ISSUER=owl-admin

# ---------------------------------------------------------------------------
# owl-admin (Rails)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://owl:owl@postgres:5432/owl_admin
OWL_API_URL=http://owl-api:8000
OWL_INTERNAL_TOKEN=dev-internal-token-change-me
# RAILS_MASTER_KEY is read from owl-admin/config/master.key in dev (bind-mounted).

# ---------------------------------------------------------------------------
# owl-web (Vite) — build-time, must be prefixed VITE_
# ---------------------------------------------------------------------------
VITE_ADMIN_API_URL=http://localhost:3000
VITE_OWL_API_URL=http://localhost:8000
