<!DOCTYPE html>
<html>
  <head>
    <title><%= [content_for(:title), "Owl Admin"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-paper text-ink font-sans">
    <% if user_signed_in? && current_user.admin? %>
      <div class="mx-auto flex min-h-dvh max-w-6xl">
        <aside class="hidden w-52 shrink-0 flex-col gap-1 border-r border-owl-100 p-4 sm:flex">
          <div class="mb-4 flex items-center gap-2 px-2">
            <span aria-hidden="true" class="text-xl">🦉</span>
            <span class="font-display text-lg font-semibold">Owl Admin</span>
          </div>
          <%= admin_nav_link "Panel", admin_root_path %>
          <%= admin_nav_link "Conversaciones", admin_conversations_path %>
          <%= admin_nav_link "Satisfacción", admin_satisfaction_path %>
          <%= admin_nav_link "Becas", admin_scholarships_path %>
          <%= admin_nav_link "Fuentes", admin_sources_path %>
          <%= admin_nav_link "Usuarios", admin_users_path %>
          <%= admin_nav_link "Feature flags", "/admin/flipper" %>
          <% if Rails.env.development? %>
            <%= admin_nav_link "Correos (dev)", "/letter_opener" %>
          <% end %>
          <div class="mt-auto border-t border-owl-100 pt-3 text-xs text-muted">
            <p class="truncate px-2"><%= current_user.email %></p>
            <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete,
                  class: "mt-1 w-full rounded px-2 py-1 text-left hover:bg-owl-50" %>
          </div>
        </aside>

        <main class="min-w-0 flex-1 p-6">
          <% flash.each do |type, message| %>
            <div class="mb-4 rounded-lg border px-4 py-2 text-sm <%= type.to_s == "alert" ? "border-red-200 bg-red-50 text-red-800" : "border-emerald-200 bg-emerald-50 text-emerald-800" %>">
              <%= message %>
            </div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center p-6">
        <% flash.each do |type, message| %>
          <div class="mb-4 rounded-lg border px-4 py-2 text-sm <%= type.to_s == "alert" ? "border-red-200 bg-red-50 text-red-800" : "border-emerald-200 bg-emerald-50 text-emerald-800" %>">
            <%= message %>
          </div>
        <% end %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
