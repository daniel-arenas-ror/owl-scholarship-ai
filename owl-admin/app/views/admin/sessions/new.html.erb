<% content_for :title, "Iniciar sesión" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center gap-2">
    <span aria-hidden="true" class="text-2xl">🦉</span>
    <h1 class="font-display text-2xl font-semibold">Owl Admin</h1>
  </div>

  <%= form_with url: user_session_path, scope: :user, method: :post, class: "flex flex-col gap-3" do |f| %>
    <label class="flex flex-col gap-1 text-sm">
      Correo
      <%= f.email_field :email, autocomplete: "email", required: true,
            class: "rounded-lg border border-owl-100 px-3 py-2 outline-none focus:border-owl-500" %>
    </label>
    <label class="flex flex-col gap-1 text-sm">
      Contraseña
      <%= f.password_field :password, autocomplete: "current-password", required: true,
            class: "rounded-lg border border-owl-100 px-3 py-2 outline-none focus:border-owl-500" %>
    </label>
    <%= f.submit "Entrar",
          class: "mt-1 rounded-lg bg-owl-500 px-4 py-2 font-medium text-white hover:bg-owl-600" %>
  <% end %>
</div>
