<% content_for :title, "Becas" %>

<h1 class="mb-2 font-display text-2xl font-semibold">Inventario de becas</h1>
<p class="mb-6 text-sm text-muted">
  La única tabla de becas del sistema (la de owl-api). Se crean con el scraper;
  aquí puedes editarlas y owl-api las vuelve a trocear y embeber.
</p>

<div class="overflow-x-auto rounded-xl border border-owl-100 bg-white">
  <table class="w-full text-sm">
    <thead class="border-b border-owl-100 text-left text-xs uppercase tracking-wide text-muted">
      <tr>
        <th class="px-4 py-2">Beca</th>
        <th class="px-4 py-2">Fuente</th>
        <th class="px-4 py-2">Niveles</th>
        <th class="px-4 py-2">Actualizada</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-owl-100">
      <% @scholarships.each do |scholarship| %>
        <tr class="hover:bg-owl-50">
          <td class="px-4 py-2">
            <%= link_to scholarship.title, admin_scholarship_path(scholarship), class: "text-owl-600 underline" %>
            <p class="text-xs text-muted"><%= scholarship.provider %></p>
          </td>
          <td class="px-4 py-2 text-muted"><%= scholarship.source %></td>
          <td class="px-4 py-2 text-muted"><%= Array(scholarship.levels).join(", ").presence || "—" %></td>
          <td class="px-4 py-2 text-muted"><%= l(scholarship.updated_at, format: :short) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @scholarships.empty? %>
    <p class="px-4 py-3 text-sm text-muted">Nada en el inventario todavía — corre el scraper sobre una URL.</p>
  <% end %>
</div>
