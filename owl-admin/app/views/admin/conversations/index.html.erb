<% content_for :title, "Conversaciones" %>

<h1 class="mb-6 font-display text-2xl font-semibold">Conversaciones</h1>

<div class="overflow-x-auto rounded-xl border border-owl-100 bg-white">
  <table class="w-full text-sm">
    <thead class="border-b border-owl-100 text-left text-xs uppercase tracking-wide text-muted">
      <tr>
        <th class="px-4 py-2">Conversación</th>
        <th class="px-4 py-2">Usuario</th>
        <th class="px-4 py-2 text-right">Mensajes</th>
        <th class="px-4 py-2">Última actividad</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-owl-100">
      <% @conversations.each do |conversation| %>
        <tr class="hover:bg-owl-50">
          <td class="px-4 py-2">
            <%= link_to conversation.title.presence || "Conversación ##{conversation.id}",
                  admin_conversation_path(conversation), class: "text-owl-600 underline" %>
          </td>
          <td class="px-4 py-2 text-muted"><%= conversation.user&.email %></td>
          <td class="px-4 py-2 text-right"><%= conversation.messages_count %></td>
          <td class="px-4 py-2 text-muted">
            <%= conversation.last_activity_at ? l(conversation.last_activity_at.to_time, format: :short) : "—" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @conversations.empty? %>
    <p class="px-4 py-3 text-sm text-muted">No hay conversaciones.</p>
  <% end %>
</div>
