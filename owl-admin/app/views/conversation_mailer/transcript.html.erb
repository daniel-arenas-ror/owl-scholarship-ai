<div style="font-family: -apple-system, 'Segoe UI', sans-serif; color: #1b1c29; max-width: 560px; margin: 0 auto;">
  <p style="font-size: 20px; font-weight: 600; margin: 0 0 4px;">🦉 Owl</p>
  <p style="color: #5b5e76; font-size: 13px; margin: 0 0 24px;">
    <%= @conversation.title.presence || "Conversación ##{@conversation.id}" %>
    · <%= l(@conversation.created_at, format: :long) %>
  </p>

  <% @messages.each do |message| %>
    <div style="margin-bottom: 16px; padding: 12px 16px; border-radius: 12px; background: <%= message.user? ? '#3a3e8f' : '#ecebf6' %>; color: <%= message.user? ? '#ffffff' : '#1b1c29' %>;">
      <p style="margin: 0 0 4px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.75;">
        <%= message.user? ? "Tú" : "Owl" %>
      </p>
      <p style="margin: 0; white-space: pre-wrap; font-size: 14px; line-height: 1.5;"><%= message.content %></p>
      <% if message.citations.present? %>
        <ul style="margin: 8px 0 0; padding-left: 18px; font-size: 12px; opacity: 0.85;">
          <% message.citations.each do |citation| %>
            <li><a href="<%= citation["source_url"] %>" style="color: inherit;"><%= citation["title"] %></a></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>

  <p style="color: #5b5e76; font-size: 12px; margin-top: 24px;">
    Enviado porque lo pediste en el chat de Owl.
  </p>
</div>
